metadata.repository.*.json

# ============================================================
#  Reti di sicurezza per estensione
#  Evitano che un "git add ." pesante passi da una cartella nuova
# ============================================================
*.svs
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.h5
*.parquet
# eccezione: gli split TP/FN/TN dell'analisi XAI sono piccoli (<1 MB) e servono
!coad_stad_explainability/*.parquet

# ============================================================
#  Ambiente e temporanei
# ============================================================
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Optuna sqlite studies (created by SLURM arrays)
optuna_hist2sig_*.db
optuna_hist2sig_*.db.lock
*.db-journal
*.db-wal
*.db-shm

# Weights & Biases offline artifacts
wandb/
wandb_cache/
wandb_optuna_*/

# Local plots/output
Immagini_temp/
predictions/

# results/: ignore everything except final val predictions per fold and the
# CPTAC prediction from the refit model (line 26 "results" would otherwise
# ignore this directory wholesale, since gitignore matches by basename).
!results/
results/*
!results/fold_*/
!results/cptac/
results/fold_*/*
!results/fold_*/val_predictions_activities.csv
!results/fold_*/val_predictions_profiles.csv
results/cptac/*
!results/cptac/cptac_exposures.csv
!results/README.md

# checkpoints/: keep the final model checkpoint (line 3 "checkpoints" would
# otherwise ignore this directory wholesale).
!checkpoints/
!checkpoints/*.pt

# Local datasets / exports
Case_ID_images_features.txt
Case_ID_images_union_features_features_complete.txt
bad_files.txt

